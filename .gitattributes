# Normalize line endings for all text files so editors/OneDrive syncing
# stop flip-flopping every file between CRLF and LF on each commit.
* text=auto eol=lf

# Keep Windows batch/cmd files as CRLF if any exist
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.docx binary
*.zip binary
