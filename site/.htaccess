RewriteEngine On
RewriteBase /

# Force non-www
RewriteCond %{HTTP_HOST} ^www\.mynestchapter\.com$ [NC]
RewriteRule ^ https://mynestchapter.com%{REQUEST_URI} [R=301,L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Block access to includes directory
RewriteRule ^includes/ - [F,L]

# Block direct HTTP access to admin config and auth files
RewriteRule ^admin/config\.php$ - [F,L]
RewriteRule ^admin/auth\.php$ - [F,L]

# Block direct access to paid products only — free PDFs (freebie_ and mnc-coloring-) are publicly accessible
RewriteRule ^downloads/now-what-workbook\.pdf$ - [F,L]
RewriteRule ^downloads/garage-sale-planner\.pdf$ - [F,L]
RewriteRule ^downloads/someday-companion\.pdf$ - [F,L]

# --- Old pages (Nov 2026 one-page site) ---
# The website is now one page. Every old address forwards somewhere useful,
# so old Google results, posts and emails never land on an error.
# These run BEFORE the "file exists" rule, so a leftover .php file on the
# server can't be served either.

# About now lives in the "About me" section of the home page
RewriteRule ^about(\.php)?/?$ /#about [R=301,NE,L]

# Pages whose job the home page does now
RewriteRule ^(start-here|connect|blog|blog-post|freebies|resources|coloring|nest-type)(\.php)?/?$ / [R=301,L]
RewriteRule ^blog/[a-z0-9-]+/?$ / [R=301,L]

# Buying happens in the Hub Shop
RewriteRule ^(shop|tools|workbook|product|checkout)(\.php)?/?$ https://hub.mynestchapter.com/#/shop [R=301,NE,L]
RewriteRule ^shop/[a-z0-9-]+/?$ https://hub.mynestchapter.com/#/shop [R=301,NE,L]

# Accounts, freebies and the old dashboard live in the Hub
RewriteRule ^(login|register|forgot-password|reset-password|dashboard|6pm-cheat-sheet)(\.php)?/?$ https://hub.mynestchapter.com/ [R=301,L]

# If the file or directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --- Clean URL Routes ---

# Homepage
RewriteRule ^$ index.php [L]

# Empty Nester quiz (the Hub links here)
RewriteRule ^nester-quiz/?$ nester-quiz.php [L]

# Download with token
RewriteRule ^download/([a-zA-Z0-9]+)/?$ download.php?token=$1 [L]

# API routes
RewriteRule ^api/auth/?$ api/auth.php [L]
RewriteRule ^api/webhook/?$ api/stripe-webhook.php [L]
RewriteRule ^api/email/?$ api/email.php [L]
RewriteRule ^api/photo-identify/?$ api/photo-identify.php [L]
RewriteRule ^api/price-lookup/?$ api/price-lookup.php [L]

# 404
ErrorDocument 404 /404.php
